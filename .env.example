# Template for .env — copy to .env and fill in real values.
#   cp .env.example .env
# The real .env is gitignored because it holds live credentials.
#
# ADR-0016: every identifier that used to be hardcoded as the literal
# string "visionguard" in app/infra code now flows from here instead —
# KEYCLOAK_REALM and KC_CLIENT_ID in particular. Changing the product's
# internal slug again in the future should mean editing this file (plus
# re-running scripts/reset-realm.sh, since Keycloak's realm import file
# still has to physically match these values — see that file's header
# comment), not grepping the codebase for a literal string.

# --- Postgres (application data) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Postgres (Keycloak's own store) ---
KC_DB_USERNAME=
KC_DB_PASSWORD=
KC_DB_NAME=

# --- Keycloak master admin (separate from the app realm's own admin user) ---
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KC_HOSTNAME=
# Scheme the public-facing edge terminates TLS at, e.g. "https" when this
# sits behind an HTTPS reverse proxy (system nginx + certbot). Leave unset
# for the plain-http LAN demo. Must match reality or every login 401s.
KC_ISSUER_SCHEME=

# Host port for infra/reverse-proxy's container (defaults to 80). Set to a
# free port when something else on the host already owns 80/443, and have
# that other reverse proxy forward to this port instead.
APP_HTTP_PORT=

# --- Identity: which Keycloak realm/client the app points at (ADR-0016) ---
# Must match infra/keycloak/import/realm-smart-cctv-ai.json exactly —
# that file has no templating and hardcodes the same realm/client names,
# since Keycloak's own --import-realm reads a static JSON file. Run
# scripts/reset-realm.sh after changing either side of that pairing.
KEYCLOAK_REALM=
KC_CLIENT_ID=

# --- Service account backend uses to call the Keycloak Admin API
#     (must match realm-smart-cctv-ai.json exactly, same reason as above) ---
KC_USER_MANAGER_CLIENT_ID=
KC_USER_MANAGER_SECRET=

# --- Email notifications (demo: Mailpit catcher, view at :8025) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USE_TLS=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# --- Object storage for violation snapshot evidence (ADR-0017) ---
# Console at http://<host>:9091 — S3 API port (9000) is internal-only.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=
